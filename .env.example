# Database
DATABASE_URL=postgresql://viralix:password@localhost:5432/viralix

# Auth
JWT_SECRET=change-me-in-production

# Server
PORT=8090
NODE_ENV=development
SITE_URL=http://localhost:5174

# AI Workers (self-hosted endpoints)
LLAMA_WORKER_URL=http://localhost:8100
SD_WORKER_URL=http://localhost:8101
COGVIDEO_WORKER_URL=http://localhost:8102
ANIMATEDIFF_WORKER_URL=http://localhost:8103
TTS_WORKER_URL=http://localhost:8104
FFMPEG_WORKER_URL=http://localhost:8105

# Job Queue (Redis)
REDIS_URL=redis://localhost:6379

# Platform OAuth credentials (users configure their own)
# These are app-level OAuth apps registered with each platform
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Storage
STORAGE_BACKEND=local
# For S3: STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=viralix-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Fine-tuning
FINETUNE_ENABLED=false
FINETUNE_MIN_SAMPLES=100

{
  "name": "viralix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @viralix/web --filter @viralix/api run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:migrate": "pnpm --filter @viralix/db run migrate",
    "db:generate": "pnpm --filter @viralix/db run generate"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.4.2"
  }
}
